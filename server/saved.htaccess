# The Slate — /filmmaking/saved/
#
# Upload this file to public_html/filmmaking/saved/.htaccess BY HAND, once.
# It cannot be deployed: saved/ is deliberately a sibling of slate/, outside
# the deploy target, so that a deploy can never delete the team's storyboards.
#
# This folder is now CLOSED to the web entirely. Storyboards used to be fetched
# from here as static files, which was only safe because basic auth sat in
# front of the whole of /filmmaking/. Now that accounts are handled by the app,
# reads go through slate/load.php behind a session check, and nothing in here
# should be reachable over HTTP at all.
#
# PHP reads these files from disk, which no directive here affects.

Options -Indexes -ExecCGI

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>

# Same answer again for hosts where .htaccess authorization is overridden
# somewhere above us, and to cover the internal .versions/, .trash/ and .tmp/
# folders explicitly.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule .* - [F,L]
</IfModule>

# Never let anything here be treated as a program. save.php only ever writes
# server-named .json files, but this folder is written to by a web endpoint, so
# assume nothing.
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py .shtml
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py .shtml
AddType text/plain .php .phtml .phar .cgi .pl .py

<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>
