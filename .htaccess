# The Slate — /filmmaking/slate/
#
# Sign-in is handled by the shared accounts in /filmmaking/auth/, so nothing
# here does authentication. index.php is the only way in.

DirectoryIndex index.php

Options -Indexes

# app.html and page.html are the tool itself (page.html is app.html unpacked
# by tools/bundle.py build), served by index.php only after a session check.
# Without this, anyone could skip the sign-in page by asking for it directly.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(app|page)\.html$ - [F,L]
  RewriteRule ^lib\.php$ - [F,L]
  RewriteRule (^|/)\. - [F,L]
</IfModule>

# Belt to that braces, in case mod_rewrite is unavailable.
<FilesMatch "^(app\.html|page\.html|lib\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>
