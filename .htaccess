# The Slate — /filmmaking/slate/
#
# Basic auth is inherited from /filmmaking/.htaccess (cPanel Directory
# Privacy); nothing here should touch authentication.

# The app is a single self-extracting index.html. This matches the server
# default, but state it explicitly so the bare folder URL cannot be broken by
# a host-level DirectoryIndex change.
DirectoryIndex index.html

Options -Indexes

# Keep the team library JSON out of caches — it changes whenever someone saves.
<IfModule mod_headers.c>
  <FilesMatch "\.(php)$">
    Header set Cache-Control "no-store"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>
