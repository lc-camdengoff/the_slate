# The Slate — /filmmaking/slate/
#
# Accounts are handled by the app itself (PostgreSQL sessions, see auth.php),
# so nothing here does authentication. index.php is the only way in.

DirectoryIndex index.php

Options -Indexes

# app.html is the tool itself, served by index.php only after a session check.
# Without this, anyone could skip the sign-in page by asking for it directly.
# Same for the config, the schema and anything else that is not meant to be
# fetched over HTTP.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^app\.html$ - [F,L]
  RewriteRule ^config\.php$ - [F,L]
  RewriteRule ^schema\.sql$ - [F,L]
  RewriteRule ^config\.sample\.php$ - [F,L]
  RewriteRule (^|/)\. - [F,L]
</IfModule>

# Belt to that braces, in case mod_rewrite is unavailable.
<FilesMatch "^(app\.html|schema\.sql|config\.php|config\.sample\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Includes, not entry points: these do nothing on their own, but there is no
# reason for them to be reachable.
<FilesMatch "^(lib|auth|db|page)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>
