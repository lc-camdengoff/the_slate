# Shared accounts for the filmmaking tools — /filmmaking/auth/
#
# The sign-in, sign-up and account pages live here and must stay reachable.
# The includes and the schema must not.

DirectoryIndex login.php

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(auth|db|page|people|tools|email)\.php$ - [F,L]
  RewriteRule ^schema\.sql$ - [F,L]
  RewriteRule ^config(\.sample)?\.php$ - [F,L]
  RewriteRule (^|/)\. - [F,L]
</IfModule>

# Belt to that braces, in case mod_rewrite is unavailable.
<FilesMatch "^(auth|db|page|people|tools|email|config|config\.sample)\.php$|^schema\.sql$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>
